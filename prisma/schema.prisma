// Bem-te-vi API — schema do MVP (PostgreSQL 15+)
//
// Convenções:
//   * id: uuid (@default(uuid()))
//   * tenantId: presente em toda entidade de negócio — base do isolamento multi-tenant
//     (shared DB + tenantId; Row Level Security fica como camada extra a considerar depois)
//   * createdAt/updatedAt: mantidos pelo Prisma (@default(now()) / @updatedAt)
//   * soft delete: só em Patient (deletedAt), por ser dado de prontuário
//   * Json: usado onde a forma dos dados varia por tenant (branding, respostas de anamnese, endereço)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// 01. TENANCY & ACESSO
// =============================================================================

enum TenantStatus {
  active
  suspended
}

model Tenant {
  id            String       @id @default(uuid())
  name          String       @db.VarChar(150)
  subdomain     String       @unique @db.VarChar(63)
  customDomain  String?      @unique @map("custom_domain") @db.VarChar(255)
  // Prova de posse do domínio próprio (registro TXT). Token e verificação são resetados
  // sempre que customDomain muda; sem token/verifiedAt, é como se não tivesse domínio nenhum
  // para fins de resolução pública de marca — só um domínio verificado controla o que aparece
  // nesse host (ver PublicBrandingService).
  customDomainVerificationToken String?   @map("custom_domain_verification_token") @db.VarChar(64)
  customDomainVerifiedAt        DateTime? @map("custom_domain_verified_at")
  status        TenantStatus @default(active)
  // A clínica que hospeda o backoffice da própria plataforma (não é uma cliente). Só criada
  // por `prisma/bootstrap-platform.ts`, nunca pelo signup público — CreateTenantDto não tem
  // este campo, então não há como uma requisição de fora setá-lo.
  isPlatform    Boolean      @default(false) @map("is_platform")
  // Duração do atendimento usada quando o agendamento não informa o fim e o profissional
  // não tem duração própria; e o piso aplicado a qualquer agendamento da clínica
  // (ex.: estética 30 min; psicologia com mínimo de 60 min).
  defaultAppointmentDurationMinutes Int @default(30) @map("default_appointment_duration_minutes")
  minAppointmentDurationMinutes     Int @default(5)  @map("min_appointment_duration_minutes")
  // Pedido de encerramento da conta feito pela própria clínica (ver TenantClosureService).
  // A clínica continua funcionando durante a carência (para exportar os dados ou desistir);
  // depois dela, a plataforma pode excluir tudo definitivamente.
  closureRequestedAt       DateTime? @map("closure_requested_at")
  closureRequestedByUserId String?   @map("closure_requested_by_user_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  branding      TenantBranding?
  logo          TenantLogo?
  users         User[]
  roles         Role[]
  patients      Patient[]
  appointments  Appointment[]
  anamnesisTemplates AnamnesisTemplate[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

// Prova de que uma clínica foi excluída, quando, a pedido de quando e por qual admin da
// plataforma. Fica de fora do tenant de propósito (sem FK): é o único registro que sobra
// depois que todos os dados da clínica são apagados.
model TenantDeletion {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  name               String   @db.VarChar(150)
  subdomain          String   @db.VarChar(63)
  closureRequestedAt DateTime @map("closure_requested_at")
  deletedByUserId    String   @map("deleted_by_user_id")
  deletedAt          DateTime @default(now()) @map("deleted_at")

  @@map("tenant_deletions")
}

model TenantBranding {
  id              String   @id @default(uuid())
  tenantId        String   @unique @map("tenant_id")
  tradeName       String?  @map("trade_name") @db.VarChar(150)
  logoUrl         String?  @map("logo_url")
  primaryColor    String?  @map("primary_color") @db.VarChar(7)
  secondaryColor  String?  @map("secondary_color") @db.VarChar(7)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

// Logo enviado pela própria clínica (upload), servido em GET /public/logos/:id. Tabela à parte
// de TenantBranding para os bytes não virem junto em toda leitura da marca. O id muda a cada
// upload: a URL vira imutável e pode ser cacheada para sempre (troca de logo = URL nova).
model TenantLogo {
  id         String   @id @default(uuid())
  tenantId   String   @unique @map("tenant_id")
  mimeType   String   @map("mime_type") @db.VarChar(50)
  data       Bytes
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_logos")
}

enum UserStatus {
  active
  invited
  disabled
}

// email único globalmente (não por tenant) — simplifica login no MVP.
// Guardar sempre em minúsculas na aplicação antes de gravar/consultar.
// Se um profissional precisar atender em duas clínicas, isso vira uma
// limitação real; a saída é evoluir para pessoa + membership por tenant.
model User {
  id            String     @id @default(uuid())
  tenantId      String     @map("tenant_id")
  roleId        String     @map("role_id")
  name          String     @db.VarChar(150)
  email         String     @unique @db.VarChar(150)
  passwordHash  String     @map("password_hash")
  // Incrementada a cada troca/redefinição de senha e gravada no token (`pwv`); token com
  // versão diferente é recusado (ver JwtStrategy). Assim trocar a senha derruba as sessões
  // abertas — inclusive a de quem roubou a senha antiga. Contador em vez de data porque o
  // `iat` do JWT tem resolução de segundos e deixaria uma janela na comparação.
  passwordVersion Int @default(0) @map("password_version")
  status        UserStatus @default(active)
  // Sobrescreve a duração padrão da clínica para os agendamentos deste profissional.
  defaultAppointmentDurationMinutes Int? @map("default_appointment_duration_minutes")
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  anamnesisRecords AnamnesisRecord[]
  appointments  Appointment[] @relation("AppointmentProfessional")
  chargesCreated Charge[]
  paymentsRecorded Payment[]
  tokens        UserToken[]
  legalAcceptances LegalAcceptance[]

  @@index([tenantId])
  @@map("users")
}

enum LegalDocument {
  terms
  privacy
}

// Aceite de Termos de Uso / Política de Privacidade (LGPD): prova de qual versão cada pessoa
// aceitou, quando e de onde. Um registro por aceite (nunca sobrescrito): quando a versão muda,
// o novo aceite vira outra linha e o histórico fica.
model LegalAcceptance {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  tenantId   String        @map("tenant_id")
  document   LegalDocument
  version    String        @db.VarChar(50)
  ip         String?       @db.VarChar(64)
  userAgent  String?       @map("user_agent") @db.VarChar(300)
  acceptedAt DateTime      @default(now()) @map("accepted_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, document])
  @@map("legal_acceptances")
}

enum UserTokenType {
  password_reset
  invite
}

// Token de uso único enviado por email (recuperar senha, aceitar convite). Só o hash SHA-256
// fica no banco: quem lê o banco não consegue usar um link pendente. Usado ou expirado, não
// vale mais; emitir um novo do mesmo tipo invalida os anteriores ainda pendentes.
model UserToken {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  type       UserTokenType
  tokenHash  String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime      @map("expires_at")
  usedAt     DateTime?     @map("used_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

model Role {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String   @db.VarChar(80)
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

// Catálogo global de permissões (ex.: "patients:create", "appointments:manage").
// Não é por tenant — cada tenant só escolhe quais permissões cada role tem.
model Permission {
  id           String   @id @default(uuid())
  key          String   @unique @db.VarChar(100)
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  roles        RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id")
  permissionId  String @map("permission_id")

  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Trilha de auditoria (LGPD): quem acessou ou alterou dado de paciente, quando e de onde.
// Só é escrita pela aplicação, nunca editada: um trigger no banco recusa UPDATE (ver a migration
// audit_log). Não tem FK para usuário nem paciente de propósito — o registro precisa sobreviver
// ao que referencia e não pode ser reescrito por cascata; só some junto com a clínica.
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  actorUserId String   @map("actor_user_id")
  // Ex.: patient.view, patient.update, clinical_record.list (ver AuditAction).
  action      String   @db.VarChar(60)
  // Paciente envolvido, quando há um: é por ele que a clínica responde "quem viu meus dados?".
  patientId   String?  @map("patient_id")
  entityType  String?  @map("entity_type") @db.VarChar(40)
  entityId    String?  @map("entity_id")
  // Detalhes da ação: campos alterados (de → para), termo buscado, etc. Nunca conteúdo clínico.
  details     Json?
  ip          String?  @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// 02. PACIENTES & ANAMNESE
// =============================================================================

model Patient {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  fullName    String    @map("full_name") @db.VarChar(150)
  // Só dígitos (11): normalizado na entrada. Busca por CPF e a unique dependem disso.
  cpf         String?   @db.VarChar(14)
  birthDate   DateTime? @map("birth_date") @db.Date
  phone       String?   @db.VarChar(20)
  email       String?   @db.VarChar(150)
  address     Json?
  notes       String?
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  anamnesisRecords  AnamnesisRecord[]
  appointments      Appointment[]
  charges           Charge[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@map("patients")
}

// Formulário de anamnese configurável por tenant: cada clínica define seus próprios campos
// (chave, rótulo, tipo, obrigatório, opções) em vez de um JSON livre sem forma nenhuma.
// Forma de `fields`: AnamnesisFieldDefinition[] (ver anamnesis-templates/anamnesis-answers.validator.ts).
model AnamnesisTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String   @db.VarChar(100)
  fields    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records AnamnesisRecord[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("anamnesis_templates")
}

// Ficha de anamnese preenchida para um paciente, segundo um AnamnesisTemplate do tenant.
// `answers` é validado contra os campos do template no momento do registro (não há garantia
// no banco de que continua batendo se o template for editado depois — ver o serviço).
model AnamnesisRecord {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  patientId     String   @map("patient_id")
  templateId    String   @map("template_id")
  filledByUserId String  @map("filled_by_user_id")
  answers       Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  template      AnamnesisTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  filledBy      User              @relation(fields: [filledByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([patientId])
  @@index([templateId])
  @@map("anamnesis_records")
}

// =============================================================================
// 03. AGENDA
// =============================================================================

enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

model Appointment {
  id               String            @id @default(uuid())
  tenantId         String            @map("tenant_id")
  patientId        String            @map("patient_id")
  professionalId   String            @map("professional_id")
  scheduledAt      DateTime          @map("scheduled_at")
  endsAt           DateTime          @map("ends_at")
  status           AppointmentStatus @default(scheduled)
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional User    @relation("AppointmentProfessional", fields: [professionalId], references: [id], onDelete: Restrict)
  charges      Charge[]

  // (tenantId, scheduledAt) serve à listagem paginada (filtra o tenant e ordena/filtra por horário);
  // substitui o índice só por tenantId, que ele já cobre.
  @@index([tenantId, scheduledAt])
  @@index([professionalId, scheduledAt])
  @@index([patientId])
  @@map("appointments")
}

// =============================================================================
// 04. FINANCEIRO
// =============================================================================
//
// Módulo nativo de cobrança e pagamento. Emissão de nota fiscal (NFS-e) fica fora de
// propósito por enquanto: é serviço municipal (não federal/estadual), cada um dos +5.000
// municípios brasileiros pode ter seu próprio webservice/regra de ISS, e por isso toda
// aplicação séria integra com um provedor certificado (Focus NFe, eNotas, PlugNotas, etc.)
// em vez de falar direto com a prefeitura — vira uma peça plugável quando isso entrar.

enum ChargeStatus {
  pending
  paid
  cancelled
}

enum PaymentMethod {
  cash
  pix
  credit_card
  debit_card
  bank_transfer
  other
}

// Cobrança de um paciente por um serviço prestado — normalmente ligada a um agendamento,
// mas não obrigatoriamente (cobrança avulsa). "Atrasada" não é um status próprio: é
// `pending` com `dueDate` no passado, calculado na leitura (ver BillingService), não
// armazenado — evita precisar de um job agendado só para marcar isso.
model Charge {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  patientId       String       @map("patient_id")
  appointmentId   String?      @map("appointment_id")
  description     String       @db.VarChar(200)
  // Em centavos (R$ 150,00 = 15000): evita ponto flutuante e Decimal na camada de aplicação —
  // mesma convenção usada por APIs de pagamento (ex.: Stripe).
  amountCents     Int          @map("amount_cents")
  dueDate         DateTime     @map("due_date") @db.Date
  status          ChargeStatus @default(pending)
  createdByUserId String       @map("created_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy   User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@index([tenantId])
  @@index([patientId])
  @@index([tenantId, status, dueDate])
  @@map("charges")
}

// Pagamento (total ou parcial) registrado contra uma cobrança. A soma dos pagamentos de uma
// cobrança nunca passa do valor dela (checado em transação com advisory lock por cobrança,
// mesmo padrão do lock de sobreposição de agenda); quando bate, a cobrança vira `paid` sozinha.
model Payment {
  id               String        @id @default(uuid())
  tenantId         String        @map("tenant_id")
  chargeId         String        @map("charge_id")
  amountCents      Int           @map("amount_cents")
  method           PaymentMethod
  paidAt           DateTime      @default(now()) @map("paid_at")
  notes            String?
  recordedByUserId String        @map("recorded_by_user_id")
  createdAt        DateTime      @default(now()) @map("created_at")

  charge     Charge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  recordedBy User   @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([chargeId])
  @@map("payments")
}
