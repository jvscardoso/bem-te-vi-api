DATABASE_URL="postgresql://user:password@localhost:5432/bem_te_vi?schema=public"

# Segredo que assina os tokens. "change-me" só serve em dev: com NODE_ENV=production (como na
# imagem Docker), a API se recusa a subir com valor de exemplo ou com menos de 32 caracteres.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"
# Validade do token de acesso. Curta de propósito: a sessão continua pelo refresh token (cookie),
# que vence com 12 h sem uso e dura no máximo 24 h desde o login.
JWT_EXPIRES_IN="15m"

# Cookie do refresh token com a flag Secure (só HTTPS). Vazio: Secure em produção e não em dev.
# Use false só numa stack local em http com NODE_ENV=production (o Docker de dev).
AUTH_COOKIE_SECURE=

PORT=3000

# Domínio base do produto (whitelabel): "<subdominio>.<APP_BASE_DOMAIN>" resolve a clínica em
# GET /public/branding. Deixe vazio em dev para usar só o subdomínio puro (?host=clinica-a).
APP_BASE_DOMAIN=

# Subdomínios que nenhuma clínica pode usar, além da lista fixa do código (www, api, app,
# admin, backoffice, mail...). Separados por vírgula.
RESERVED_SUBDOMAINS=

# CORS: origens que podem chamar a API pelo navegador, além do APP_BASE_DOMAIN e seus
# subdomínios e dos domínios próprios verificados das clínicas (e de localhost fora de produção).
# Origens exatas, separadas por vírgula. Ex.: a landing num domínio separado.
CORS_EXTRA_ORIGINS=

# Email (recuperação de senha e convite) por SMTP genérico: qualquer provedor (Resend, SES,
# Brevo, Postmark...). Em dev, o Mailpit do docker-compose: SMTP em localhost:1025 e caixa de
# entrada em http://localhost:8025. Sem SMTP_HOST, a API só registra os emails no log.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# true só para TLS direto (porta 465); nas demais portas o STARTTLS é negociado sozinho.
SMTP_SECURE=false
MAIL_FROM="bem-te-vi <nao-responda@bemtevi.local>"

# Endereço do frontend em dev, usado nos links dos emails quando APP_BASE_DOMAIN está vazio.
# Em localhost, a clínica vai no host (http://<subdominio>.localhost:5173); em outro host (ex.: um
# IP, para testar pelo celular), o link leva ?tenant=<subdominio>. Com APP_BASE_DOMAIN, vai para
# https://<subdominio>.<APP_BASE_DOMAIN> (ou para o domínio próprio verificado da clínica).
FRONTEND_URL=http://localhost:5173

# URL pública desta API, usada na URL dos logos enviados por upload (/public/logos/:id).
# A URL é gravada no upload: se mudar, os logos precisam ser reenviados.
API_PUBLIC_URL=http://localhost:3000

# Número de proxies/balanceadores na frente da API (ex.: 1). Sem isso, atrás de proxy, o IP de
# todo mundo é o do proxy: o rate limit vira um só para todos e a auditoria grava o IP errado.
# Deixe vazio se a API recebe as conexões direto (confiar no X-Forwarded-For sem proxy deixaria
# qualquer cliente forjar o próprio IP).
TRUST_PROXY=

# Versão vigente dos Termos de Uso e da Política de Privacidade (textos no frontend). Ao mudar o
# texto, suba a versão: todo usuário passa a ter aceite pendente (GET /auth/me →
# pendingLegalDocuments) e o cadastro/aceite de convite passam a exigir a versão nova.
LEGAL_TERMS_VERSION=1
LEGAL_PRIVACY_VERSION=1

# Encerramento de conta (LGPD): dias entre o pedido da clínica e a liberação da exclusão
# definitiva pelo painel da plataforma (tempo para exportar os dados ou desistir). Padrão: 30.
TENANT_DELETION_GRACE_DAYS=30
# Email da equipe da plataforma, avisado quando uma clínica pede o encerramento (opcional).
PLATFORM_CONTACT_EMAIL=
